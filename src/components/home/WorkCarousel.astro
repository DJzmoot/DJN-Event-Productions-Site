---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Icon from '../Icon.astro';
import { categoryLabel } from '../../lib/categories';

interface Props {
  projects: CollectionEntry<'projects'>[];
}
const { projects } = Astro.props;
const total = projects.length;
---

<section id="work" class="pt-10 pb-16 md:pt-14 md:pb-20" aria-labelledby="work-title">
  <div class="container-x flex flex-wrap items-end justify-between gap-4" data-reveal>
    <h2 id="work-title" class="section-title">Selected Work</h2>
    <a href="/work/" class="link-arrow label text-[0.6875rem]">
      Explore the full portfolio <Icon name="arrow" />
    </a>
  </div>

  <div
    class="carousel relative mt-8 md:mt-10"
    role="region"
    aria-roledescription="carousel"
    aria-label="Selected work"
    data-carousel
    data-reveal
  >
    <div class="carousel-viewport overflow-hidden" data-viewport>
      <div class="carousel-track flex touch-pan-y" aria-live="off" data-track>
        {
          projects.map((project, i) => {
            const d = project.data;
            const href = `/work/${project.id}/`;
            return (
              <div
                class="carousel-slide"
                role="group"
                aria-roledescription="slide"
                aria-label={`${i + 1} of ${total}: ${d.title}`}
                data-slide
              >
                <article class="slide-card relative h-full overflow-hidden rounded-[4px] border border-line bg-surface">
                  {d.cover && !d.placeholder ? (
                    <Image
                      src={d.cover.src}
                      alt={d.cover.alt}
                      widths={[480, 768, 1080, 1440, 1920]}
                      sizes="(min-width: 1024px) 78vw, 100vw"
                      loading={i === 0 ? 'eager' : 'lazy'}
                      class="slide-image absolute inset-0 h-full w-full object-cover"
                      style={`object-position:${d.cover.position}`}
                    />
                  ) : (
                    <div class="placeholder-media absolute inset-0 flex items-center justify-center">
                      <div class="relative text-center">
                        <Icon name="architectural" class="mx-auto h-12 w-12 text-faint" />
                        <p class="label mt-4 text-faint">Photography coming soon</p>
                      </div>
                    </div>
                  )}
                  <div class="slide-shade absolute inset-0" aria-hidden="true" />
                  <div class="absolute inset-x-0 bottom-0 flex flex-col gap-5 p-5 sm:p-8 md:flex-row md:items-end md:justify-between md:p-10">
                    <div class="min-w-0">
                      <p class="label flex items-center gap-3 text-[0.6875rem] text-ink/90">
                        <span class="h-2.5 w-2.5 bg-accent" aria-hidden="true" />
                        {d.eyebrow ?? categoryLabel(d.categories[0])}
                      </p>
                      <h3 class="mt-3 text-[1.5rem] leading-tight font-bold sm:text-[1.9rem] lg:text-[2.2rem]">
                        {d.title}
                      </h3>
                      {d.services.length > 0 && (
                        <p class="label mt-3 text-[0.6563rem] text-ink/75 sm:text-[0.6875rem]">
                          {d.services.join('  /  ')}
                        </p>
                      )}
                    </div>
                    <a href={href} class="btn btn-outline btn-sm shrink-0 self-start md:self-auto" data-slide-link>
                      View Project <Icon name="arrow" />
                      <span class="sr-only">: {d.title}</span>
                    </a>
                  </div>
                </article>
              </div>
            );
          })
        }
      </div>
    </div>

    <button type="button" class="carousel-arrow carousel-prev" aria-label="Previous project" data-prev>
      <Icon name="chevron-left" class="h-5 w-5" />
    </button>
    <button type="button" class="carousel-arrow carousel-next" aria-label="Next project" data-next>
      <Icon name="chevron-right" class="h-5 w-5" />
    </button>

    <div class="container-x mt-6 flex items-center justify-center gap-4">
      <div class="flex items-center" role="group" aria-label="Choose a project" data-dots>
        {
          projects.map((p, i) => (
            <button type="button" class="carousel-dot" aria-label={`Show ${p.data.title}`} data-dot={i}>
              <span />
            </button>
          ))
        }
      </div>
      <button type="button" class="carousel-toggle" aria-label="Pause automatic slide show" data-toggle hidden>
        <Icon name="pause" class="icon-pause h-4 w-4" />
        <Icon name="play" class="icon-play hidden h-4 w-4" />
      </button>
    </div>
  </div>
</section>

<style>
  .carousel-slide {
    flex: 0 0 100%;
    min-width: 0;
    padding-inline: var(--gutter);
  }
  .slide-card {
    aspect-ratio: 4 / 5;
  }
  @media (min-width: 640px) {
    .slide-card {
      aspect-ratio: 16 / 10;
    }
  }
  @media (min-width: 1024px) {
    .carousel-slide {
      flex-basis: 78%;
      padding-inline: 0.75rem;
    }
    .slide-card {
      aspect-ratio: 16 / 8;
    }
  }
  @media (min-width: 1600px) {
    .carousel-slide {
      flex-basis: 70%;
    }
  }

  .slide-shade {
    background:
      linear-gradient(to top, rgb(11 11 15 / 0.92) 0%, rgb(11 11 15 / 0.55) 32%, rgb(11 11 15 / 0) 62%);
  }

  /* Adjacent slides are dimmed previews. */
  .carousel-slide .slide-card {
    transition:
      opacity 700ms var(--ease-out-expo),
      transform 700ms var(--ease-out-expo);
  }
  .carousel-slide :global(.slide-image) {
    transition: transform 1400ms var(--ease-out-expo);
  }
  @media (min-width: 1024px) {
    .carousel-slide:not(.is-selected) .slide-card {
      opacity: 0.5;
      transform: scale(0.94);
      cursor: pointer;
    }
    .carousel-slide:not(.is-selected) .slide-card > :not(img):not(picture):not(.slide-shade):not(.placeholder-media) {
      visibility: hidden;
    }
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .carousel-slide.is-selected .slide-card:hover :global(.slide-image) {
      transform: scale(1.03);
    }
  }

  .carousel-arrow {
    position: absolute;
    top: 0;
    z-index: 2;
    display: none;
    width: 3.25rem;
    height: 3.25rem;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 1px solid rgb(245 245 247 / 0.35);
    background: rgb(11 11 15 / 0.6);
    color: var(--color-ink);
    backdrop-filter: blur(6px);
    transition:
      border-color 200ms ease,
      background-color 200ms ease;
    /* vertically centre on the slide image (set from JS). */
    transform: translateY(calc(var(--arrow-y, 200px) - 50%));
  }
  .carousel-arrow:hover {
    border-color: var(--color-accent);
    background: rgb(139 77 255 / 0.25);
  }
  .carousel-prev {
    left: calc(11% - 1.625rem);
  }
  .carousel-next {
    right: calc(11% - 1.625rem);
  }
  @media (min-width: 640px) {
    .carousel-arrow {
      display: inline-flex;
    }
    .carousel-prev {
      left: calc(var(--gutter) + 1rem);
    }
    .carousel-next {
      right: calc(var(--gutter) + 1rem);
    }
  }
  @media (min-width: 1024px) {
    .carousel-prev {
      left: calc(11% - 1.625rem);
    }
    .carousel-next {
      right: calc(11% - 1.625rem);
    }
  }
  @media (min-width: 1600px) {
    .carousel-prev {
      left: calc(15% - 1.625rem);
    }
    .carousel-next {
      right: calc(15% - 1.625rem);
    }
  }

  .carousel-dot {
    display: inline-flex;
    width: 1.75rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
  }
  .carousel-dot span {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--color-line-strong);
    transition:
      background-color 300ms ease,
      width 400ms var(--ease-out-expo);
  }
  .carousel-dot:hover span {
    background: var(--color-muted);
  }
  .carousel-dot[aria-current='true'] span {
    width: 1.25rem;
    background: var(--color-accent);
  }
  .carousel-toggle {
    display: inline-flex;
    width: 2.75rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
    color: var(--color-muted);
    border-radius: 999px;
    transition: color 200ms ease;
  }
  .carousel-toggle[hidden] {
    display: none;
  }
  .carousel-toggle:hover {
    color: var(--color-ink);
  }
  .carousel-toggle.is-paused .icon-pause {
    display: none;
  }
  .carousel-toggle.is-paused .icon-play {
    display: block;
  }
</style>

<script>
  import EmblaCarousel from 'embla-carousel';
  import Autoplay from 'embla-carousel-autoplay';

  const root = document.querySelector<HTMLElement>('[data-carousel]');
  if (root) {
    const viewport = root.querySelector<HTMLElement>('[data-viewport]')!;
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
    const toggle = root.querySelector<HTMLButtonElement>('[data-toggle]')!;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const autoplay = Autoplay({
      delay: 6000,
      playOnInit: !reduceMotion,
      stopOnInteraction: false,
      stopOnMouseEnter: true,
      stopOnFocusIn: true,
      rootNode: () => root,
    });

    const embla = EmblaCarousel(
      viewport,
      { loop: true, align: 'center', duration: reduceMotion ? 1 : 32, skipSnaps: false },
      [autoplay],
    );

    // User-controlled pause (WCAG 2.2.2). Once paused by the user, it stays paused.
    let userPaused = reduceMotion;
    const renderToggle = () => {
      toggle.classList.toggle('is-paused', userPaused);
      toggle.setAttribute('aria-label', userPaused ? 'Play automatic slide show' : 'Pause automatic slide show');
      // Announce slide changes only while not auto-rotating.
      track.setAttribute('aria-live', userPaused ? 'polite' : 'off');
    };
    toggle.hidden = false;
    renderToggle();
    toggle.addEventListener('click', () => {
      userPaused = !userPaused;
      if (userPaused) autoplay.stop();
      else autoplay.play();
      renderToggle();
    });

    // Pause while scrolled out of view or the tab is hidden.
    let inView = true;
    const resume = () => {
      if (!userPaused && inView && !document.hidden && !root.matches(':hover, :focus-within')) autoplay.play();
    };
    new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting;
      if (inView) resume();
      else autoplay.stop();
    }).observe(root);
    document.addEventListener('visibilitychange', () => (document.hidden ? autoplay.stop() : resume()));
    // stopOnMouseEnter/FocusIn restart on leave; respect a user pause.
    root.addEventListener('mouseleave', () => userPaused && autoplay.stop());
    root.addEventListener('focusout', () => queueMicrotask(() => userPaused && autoplay.stop()));

    // Selected state, dots and focusability of off-screen slides.
    const update = () => {
      const selected = embla.selectedScrollSnap();
      slides.forEach((slide, i) => {
        const active = i === selected;
        slide.classList.toggle('is-selected', active);
        slide.setAttribute('aria-hidden', String(!active));
        slide.querySelectorAll<HTMLElement>('a, button').forEach((el) => (el.tabIndex = active ? 0 : -1));
      });
      dots.forEach((dot, i) => dot.setAttribute('aria-current', String(i === selected)));
    };
    embla.on('select', update);
    embla.on('init', update);
    embla.on('reInit', update);
    update();

    // Keep arrows centred on the image height.
    const placeArrows = () => {
      const card = slides[0].querySelector<HTMLElement>('.slide-card');
      if (card) root.style.setProperty('--arrow-y', `${card.offsetHeight / 2}px`);
    };
    placeArrows();
    new ResizeObserver(placeArrows).observe(viewport);

    prev.addEventListener('click', () => {
      embla.scrollPrev();
      autoplay.reset();
    });
    next.addEventListener('click', () => {
      embla.scrollNext();
      autoplay.reset();
    });
    dots.forEach((dot, i) => dot.addEventListener('click', () => embla.scrollTo(i)));

    // Clicking a dimmed adjacent slide brings it into focus instead of navigating.
    slides.forEach((slide, i) =>
      slide.addEventListener('click', (e) => {
        if (embla.selectedScrollSnap() !== i) {
          e.preventDefault();
          embla.scrollTo(i);
        }
      }),
    );

    // Keyboard: arrow keys while focus is anywhere inside the carousel.
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        embla.scrollPrev();
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        embla.scrollNext();
      }
    });
  }
</script>
