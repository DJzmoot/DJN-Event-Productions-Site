---
import { getImage } from 'astro:assets';
import Icon from '../Icon.astro';
import { SITE } from '../../lib/site';
import crowd from '../../assets/photos/relay-liu-audience.jpg';

const bg = await getImage({ src: crowd, width: 1920, format: 'webp', quality: 55 });
const mailto = `mailto:${SITE.email}?subject=${encodeURIComponent('Project enquiry')}`;
---

<section
  id="contact"
  class="contact relative isolate overflow-hidden border-t border-line py-14 md:py-16 lg:py-20"
  aria-labelledby="contact-title"
  style={`--contact-bg:url(${bg.src})`}
>
  <div class="container-x grid gap-12 lg:grid-cols-[1.15fr_1fr] lg:items-center lg:gap-20">
    <div data-reveal>
      <h2 id="contact-title" class="display text-[2rem] tracking-[0.12em] sm:text-[2.6rem] lg:text-[3rem]">
        Let’s Create Something Exceptional.
      </h2>
      <span class="mt-7 block h-[2px] w-14 bg-accent" aria-hidden="true"></span>
      <p class="mt-7 max-w-md text-[1.0625rem] leading-relaxed text-ink/85">
        Planning an event, production, or creative lighting installation? Let’s discuss how I can contribute.
      </p>
      <a href={mailto} class="btn btn-primary mt-9">Get in touch <Icon name="arrow" /></a>
    </div>

    <ul class="contact-list border-line lg:border-l lg:pl-16" data-reveal style="--reveal-delay: 120ms">
      <li>
        <p class="label text-[0.6875rem] text-faint">Email</p>
        <a
          href={mailto}
          class="mt-2 inline-flex items-center gap-3 text-[1rem] font-semibold break-all text-ink transition-colors hover:text-accent-soft sm:text-[1.25rem]"
        >
          <Icon name="mail" class="h-5 w-5 shrink-0 text-accent-soft" />
          {SITE.email}
        </a>
      </li>
      <li>
        <p class="label text-[0.6875rem] text-faint">Phone</p>
        <a
          href={SITE.phoneHref}
          class="mt-2 inline-flex items-center gap-3 text-[1rem] font-semibold text-ink transition-colors hover:text-accent-soft sm:text-[1.25rem]"
        >
          <Icon name="phone" class="h-5 w-5 shrink-0 text-accent-soft" />
          {SITE.phone}
        </a>
      </li>
      <li>
        <p class="label text-[0.6875rem] text-faint">Based in</p>
        <p class="mt-2 inline-flex items-center gap-3 text-[1rem] font-semibold text-ink sm:text-[1.25rem]">
          <Icon name="pin" class="h-5 w-5 shrink-0 text-accent-soft" />
          {SITE.locality}, {SITE.region} · Serving the Northeast
        </p>
      </li>
    </ul>
  </div>
</section>

<style>
  .contact::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to right, rgb(11 11 15 / 0.96) 25%, rgb(11 11 15 / 0.82) 100%),
      linear-gradient(to bottom, var(--color-bg) 0%, rgb(11 11 15 / 0) 30%, rgb(11 11 15 / 0) 70%, var(--color-bg) 100%),
      var(--contact-bg) center 35% / cover no-repeat;
  }
  .contact-list > li + li {
    margin-top: 1.75rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-line);
  }
</style>
