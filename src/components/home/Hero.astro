---
import { Picture } from 'astro:assets';
import Icon from '../Icon.astro';
import heroImage from '../../assets/photos/relay-liu-arch-stage.jpg';
---

<section id="top" class="hero relative isolate overflow-hidden" aria-labelledby="hero-title">
  <div class="hero-media absolute inset-0 -z-10">
    <Picture
      src={heroImage}
      formats={['avif', 'webp']}
      widths={[768, 1080, 1440, 1920, 2048]}
      sizes="(min-width: 1024px) 70vw, 100vw"
      alt="Relay For Life at LIU Post: an inflatable arch lit in violet over the stage, with illuminated marquee letters along the front."
      loading="eager"
      fetchpriority="high"
      class="hero-image h-full w-full object-cover"
    />
  </div>

  <div class="container-x relative flex min-h-[inherit] items-end pt-[calc(var(--header-h)+3rem)] pb-14 lg:items-center lg:pb-20">
    <div class="hero-enter max-w-[46rem]">
      <p class="label flex items-center gap-5 text-[0.8125rem] tracking-[0.3em]">
        Nick Manganiello
        <span class="h-[2px] w-12 bg-accent" aria-hidden="true"></span>
      </p>
      <h1 id="hero-title" class="display mt-6 text-[2.3rem] sm:text-[3rem] lg:text-[3.1rem] xl:text-[3.5rem]">
        Creative Vision.<br />Technical Precision.
      </h1>
      <p class="label mt-7 max-w-[34rem] leading-[1.9] text-ink/90">
        Lighting Design <span class="text-accent-soft" aria-hidden="true">/</span> Technical Direction
        <span class="text-accent-soft" aria-hidden="true">/</span> Show Programming
        <span class="text-accent-soft" aria-hidden="true">/</span> Live Event Operation
      </p>
      <p class="mt-6 max-w-[31rem] text-[1.0625rem] leading-relaxed text-ink/80">
        Independent technical production expertise for live events, immersive environments, and creative
        installations throughout the Northeastern United States.
      </p>
      <div class="mt-9 flex flex-wrap gap-4">
        <a href="#work" class="btn btn-primary">View Selected Work <Icon name="arrow" /></a>
        <a href="#about" class="btn btn-outline">About Nick</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: clamp(640px, 92svh, 900px);
  }
  .hero-media::after {
    content: '';
    position: absolute;
    inset: 0;
    /* Mobile: darken the whole frame, strongest behind the text. */
    background:
      linear-gradient(to top, var(--color-bg) 4%, rgb(11 11 15 / 0.82) 45%, rgb(11 11 15 / 0.35) 100%);
  }
  .hero-media :global(img) {
    object-position: 60% 50%;
  }

  @media (min-width: 1024px) {
    .hero-media {
      left: 30%;
    }
    .hero-media::after {
      background:
        linear-gradient(to right, var(--color-bg) 0%, rgb(11 11 15 / 0.75) 22%, rgb(11 11 15 / 0) 55%),
        linear-gradient(to top, var(--color-bg) 0%, rgb(11 11 15 / 0) 22%),
        linear-gradient(to bottom, rgb(11 11 15 / 0.55) 0%, rgb(11 11 15 / 0) 20%);
    }
    .hero-media :global(img) {
      object-position: 50% 55%;
    }
  }
</style>
