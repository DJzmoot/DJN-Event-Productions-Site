---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import photo from '../../assets/photos/huntington-lighthouse-control.jpg';

const points = [
  'Subcontract and specialist roles',
  'Integrates with existing crews and workflows',
  'Production companies, agencies and venues',
  'Scalable, flexible support',
  'Reliable, professional execution',
];
---

<section id="collaboration" class="border-t border-line py-16 md:py-24" aria-labelledby="collab-title">
  <div class="container-x grid gap-10 lg:grid-cols-[0.85fr_1.2fr_0.75fr] lg:items-center lg:gap-12">
    <figure class="zoom-frame rounded-[4px] border border-line" data-reveal>
      <Image
        src={photo}
        alt="Lighting control position at the Huntington Lighthouse Festival, glowing magenta and blue, with a touchscreen and illuminated controller."
        widths={[480, 768, 1080]}
        sizes="(min-width: 1024px) 32vw, 100vw"
        class="aspect-[4/3] h-full w-full object-cover"
      />
    </figure>

    <div data-reveal style="--reveal-delay: 100ms">
      <h2 id="collab-title" class="section-title text-[1.15rem] tracking-[0.16em] xl:text-[1.375rem]">Collaboration &amp; Network</h2>
      <p class="mt-6 text-[1.375rem] leading-snug font-bold text-ink sm:text-[1.6rem]">
        Independent Expertise.<br />Seamless Collaboration.
      </p>
      <div class="prose-body mt-5">
        <p>
          From lighting design and show programming to technical direction and live operation, DJN Event Productions
          provides specialized expertise that complements existing production teams and supports technically demanding
          events.
        </p>
        <p>
          Nick regularly works alongside production companies, agencies, venues, and creative professionals across the
          Northeast — as a subcontractor, a department lead, or the technical specialist a production needs.
        </p>
      </div>
    </div>

    <ul class="space-y-4 border-line lg:border-l lg:pl-10" data-reveal style="--reveal-delay: 200ms">
      {
        points.map((p) => (
          <li class="flex items-start gap-3 text-[0.9375rem] text-ink/90">
            <Icon name="check" class="mt-0.5 h-5 w-5 shrink-0 text-accent-soft" />
            {p}
          </li>
        ))
      }
    </ul>
  </div>
</section>
