---
import { NAV, SITE } from '../lib/site';
import Wordmark from './Wordmark.astro';
const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-bg">
  <div class="container-x grid gap-10 py-10 md:grid-cols-[1.4fr_1fr_1fr] md:py-12">
    <div>
      <Wordmark />
      <p class="mt-6 max-w-sm text-sm leading-relaxed text-muted">
        The independent technical production practice of {SITE.owner}. Lighting design, technical direction, show
        programming and live event operation throughout the {SITE.serviceArea}.
      </p>
    </div>
    <nav aria-label="Footer">
      <p class="label mb-4 text-faint">Explore</p>
      <ul class="grid grid-cols-2 gap-x-6 gap-y-2.5 text-sm">
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} class="text-muted transition-colors hover:text-ink">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div>
      <p class="label mb-4 text-faint">Contact</p>
      <ul class="space-y-2.5 text-sm">
        <li><a href={`mailto:${SITE.email}`} class="text-muted transition-colors hover:text-ink">{SITE.email}</a></li>
        <li><a href={SITE.phoneHref} class="text-muted transition-colors hover:text-ink">{SITE.phone}</a></li>
        <li class="text-muted">Based in {SITE.locality}, {SITE.region}</li>
      </ul>
    </div>
  </div>
  <div class="border-t border-line">
    <div class="container-x flex flex-col gap-2 py-6 text-xs text-faint sm:flex-row sm:justify-between">
      <p>© {year} {SITE.name}. All photography shows original work.</p>
      <p>{SITE.owner} · {SITE.serviceArea}</p>
    </div>
  </div>
</footer>
