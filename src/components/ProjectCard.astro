---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { categoryLabel } from '../lib/categories';
import type { Project } from '../lib/projects';

interface Props {
  project: Project;
  eager?: boolean;
  headingLevel?: 'h2' | 'h3';
}
const { project, eager = false, headingLevel: H = 'h3' } = Astro.props;
const d = project.data;
---

<a
  href={`/work/${project.id}/`}
  class="project-card group block"
  data-categories={d.categories.join(' ')}
>
  <div class="zoom-frame relative aspect-[4/3] rounded-[4px] border border-line bg-surface">
    {
      d.cover && !d.placeholder ? (
        <Image
          src={d.cover.src}
          alt={d.cover.alt}
          widths={[480, 768, 1080]}
          sizes="(min-width: 1280px) 400px, (min-width: 768px) 45vw, 100vw"
          loading={eager ? 'eager' : 'lazy'}
          class="h-full w-full object-cover"
          style={`object-position:${d.cover.position}`}
        />
      ) : (
        <div class="placeholder-media flex h-full w-full items-center justify-center">
          <p class="label relative text-faint">Photography coming soon</p>
        </div>
      )
    }
  </div>
  <div class="mt-5">
    <p class="label text-[0.6875rem] text-accent-soft">{categoryLabel(d.categories[0])}</p>
    <H class="mt-2 flex items-start justify-between gap-4 text-[1.25rem] leading-snug font-bold transition-colors group-hover:text-accent-soft">
      {d.title}
      <Icon name="arrow" class="mt-1.5 h-4 w-4 shrink-0 text-faint transition-transform duration-300 group-hover:translate-x-1 group-hover:text-accent-soft" />
    </H>
    <p class="mt-2 text-[0.9375rem] leading-relaxed text-muted">{d.summary}</p>
    {
      (d.location || d.year) && (
        <p class="label mt-3 text-[0.625rem] text-faint">{[d.location, d.year].filter(Boolean).join('  ·  ')}</p>
      )
    }
  </div>
</a>
