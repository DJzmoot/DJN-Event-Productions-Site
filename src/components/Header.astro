---
import { NAV } from '../lib/site';
import Wordmark from './Wordmark.astro';
import Icon from './Icon.astro';

interface Props {
  /** Nav id to mark as current (`top`, `work`, …). */
  current?: string;
}
const { current } = Astro.props;
---

<header id="site-header" class="site-header fixed inset-x-0 top-0 z-50" data-current={current}>
  <div class="container-x flex h-[var(--header-h)] items-center justify-between gap-6">
    <a href="/" class="shrink-0" aria-label="DJN Event Productions — home">
      <Wordmark />
    </a>

    <nav aria-label="Primary" class="hidden lg:block">
      <ul class="flex items-center gap-8 xl:gap-10">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                data-nav={item.id}
                class="nav-link label py-2 text-[0.6875rem] tracking-[var(--tracking-nav)]"
                aria-current={current === item.id ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button
      type="button"
      class="menu-toggle -mr-2 inline-flex h-11 w-11 items-center justify-center lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
    >
      <Icon name="menu" class="icon-open h-6 w-6" />
      <Icon name="close" class="icon-close hidden h-6 w-6" />
    </button>
  </div>

  <div id="mobile-menu" class="mobile-menu lg:hidden" hidden>
    <nav aria-label="Mobile" class="container-x pt-6 pb-10">
      <ul class="flex flex-col">
        {
          NAV.map((item) => (
            <li class="border-b border-line">
              <a
                href={item.href}
                data-nav={item.id}
                class="nav-link flex min-h-14 items-center justify-between py-4 text-sm font-bold tracking-[var(--tracking-nav)] uppercase"
                aria-current={current === item.id ? 'page' : undefined}
              >
                {item.label}
                <Icon name="arrow" class="h-4 w-4 text-faint" />
              </a>
            </li>
          ))
        }
      </ul>
      <a href="/#contact" class="btn btn-primary mt-8 w-full">
        Start a conversation <Icon name="arrow" />
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    transition:
      background-color 350ms ease,
      border-color 350ms ease,
      backdrop-filter 350ms ease;
    border-bottom: 1px solid transparent;
    background: linear-gradient(to bottom, rgb(11 11 15 / 0.75), rgb(11 11 15 / 0));
  }
  .site-header.is-scrolled,
  .site-header.menu-open {
    background: rgb(11 11 15 / 0.92);
    border-bottom-color: var(--color-line);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .nav-link {
    position: relative;
    color: var(--color-ink);
    opacity: 0.86;
    transition:
      color 200ms ease,
      opacity 200ms ease;
  }
  .nav-link:hover {
    opacity: 1;
    color: var(--color-accent-soft);
  }
  nav[aria-label='Primary'] .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 350ms var(--ease-out-expo);
  }
  nav[aria-label='Primary'] .nav-link[aria-current='page'],
  nav[aria-label='Primary'] .nav-link.is-active {
    color: var(--color-accent-soft);
    opacity: 1;
  }
  nav[aria-label='Primary'] .nav-link[aria-current='page']::after,
  nav[aria-label='Primary'] .nav-link.is-active::after {
    transform: scaleX(1);
  }
  .mobile-menu .nav-link[aria-current='page'],
  .mobile-menu .nav-link.is-active {
    color: var(--color-accent-soft);
  }

  .mobile-menu {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    background: var(--color-bg);
    overflow-y: auto;
  }
  .menu-open .icon-open {
    display: none;
  }
  .menu-open .icon-close {
    display: block;
  }
</style>

<script>
  const header = document.getElementById('site-header')!;
  const toggle = header.querySelector<HTMLButtonElement>('.menu-toggle')!;
  const menu = document.getElementById('mobile-menu')!;

  // Solid header once the page has scrolled.
  const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Mobile menu
  const setOpen = (open: boolean) => {
    menu.hidden = !open;
    header.classList.toggle('menu-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    document.documentElement.style.overflow = open ? 'hidden' : '';
    if (open) menu.querySelector<HTMLElement>('a')?.focus();
  };
  toggle.addEventListener('click', () => setOpen(menu.hidden === true));
  menu.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu.hidden) {
      setOpen(false);
      toggle.focus();
    }
  });
  window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
    if (e.matches) setOpen(false);
  });

  // Scroll spy on the home page: highlight the section in view.
  if (header.dataset.current === 'top') {
    const ids = ['top', 'work', 'expertise', 'about', 'collaboration', 'contact'];
    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav]')];
    const sections = ids
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => !!el);
    const setActive = (id: string) => {
      for (const link of links) {
        const active = link.dataset.nav === id;
        link.classList.toggle('is-active', active);
        if (active) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      }
    };
    const pick = () => {
      const line = window.innerHeight * 0.35;
      let current = 'top';
      for (const s of sections) if (s.getBoundingClientRect().top <= line) current = s.id;
      setActive(current);
    };
    let ticking = false;
    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          pick();
          ticking = false;
        });
      },
      { passive: true },
    );
    pick();
  }
</script>
