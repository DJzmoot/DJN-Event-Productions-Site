---
// Monochrome line icons (24×24, 1.5px stroke). Decorative by default.
interface Props {
  name: keyof typeof paths;
  class?: string;
  label?: string;
}

const paths = {
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  'chevron-left': '<path d="m15 18-6-6 6-6"/>',
  'chevron-right': '<path d="m9 18 6-6-6-6"/>',
  check: '<path d="m5 12.5 4.5 4.5L19 7.5"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  pause: '<path d="M9 6v12M15 6v12"/>',
  play: '<path d="M8 5.5v13l11-6.5-11-6.5Z"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="1.5"/><path d="m3.5 6 8.5 7 8.5-7"/>',
  phone: '<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a1 1 0 0 1-1 1A16 16 0 0 1 4 5a1 1 0 0 1 1-1Z"/>',
  pin: '<path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.5"/>',
  calendar: '<rect x="3.5" y="5" width="17" height="15" rx="1.5"/><path d="M3.5 10h17M8 3v4M16 3v4M7.5 13.5h.01M12 13.5h.01M16.5 13.5h.01M7.5 17h.01M12 17h.01"/>',
  network: '<circle cx="12" cy="7" r="2.5"/><circle cx="5" cy="9" r="2"/><circle cx="19" cy="9" r="2"/><path d="M7.5 19a4.5 4.5 0 0 1 9 0M1.5 18a3.5 3.5 0 0 1 5.5-2.9M22.5 18a3.5 3.5 0 0 0-5.5-2.9"/>',
  // Expertise
  lighting:
    '<path d="M8 3h8v3a4 4 0 0 1-8 0V3Z"/><path d="M6 3h12"/><path d="m9.5 10.5-3 9M14.5 10.5l3 9M12 10v10" opacity=".55"/><path d="M5 21h14"/>',
  direction:
    '<path d="M6 3v18M12 3v18M18 3v18"/><rect x="4" y="13" width="4" height="3" rx=".5"/><rect x="10" y="6" width="4" height="3" rx=".5"/><rect x="16" y="10" width="4" height="3" rx=".5"/>',
  operation: '<circle cx="12" cy="12" r="9"/><path d="M10 8.5v7l5.5-3.5L10 8.5Z"/>',
  audio:
    '<rect x="6" y="3" width="12" height="18" rx="1.5"/><circle cx="12" cy="14.5" r="3.5"/><circle cx="12" cy="7.5" r="1.5"/>',
  video: '<rect x="2.5" y="4" width="19" height="13" rx="1"/><path d="M8 21h8M12 17v4"/>',
  holiday:
    '<path d="M12 2.5 13 5l2.5.2-2 1.6.7 2.4L12 7.9 9.8 9.2l.7-2.4-2-1.6L11 5l1-2.5Z"/><path d="M12 10 7 15h3l-4 5h12l-4-5h3l-5-5Z"/><path d="M12 20v1.5"/>',
  architectural:
    '<path d="M3 9 12 4l9 5"/><path d="M4 9h16M5 20h14M3.5 21.5h17"/><path d="M7 11v7M12 11v7M17 11v7"/>',
  dj: '<path d="M4 14v-2a8 8 0 0 1 16 0v2"/><rect x="3" y="14" width="4" height="6" rx="1.5"/><rect x="17" y="14" width="4" height="6" rx="1.5"/>',
} as const;

const { name, class: cls = 'h-6 w-6', label } = Astro.props;
---

<svg
  class={cls}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={paths[name]}
/>
