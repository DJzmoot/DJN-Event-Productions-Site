---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Page not found" noindex>
  <section class="container-x flex min-h-[80svh] flex-col justify-center pt-[var(--header-h)]">
    <p class="label text-accent-soft">404</p>
    <h1 class="display mt-4 text-[2.4rem] sm:text-[3.2rem]">Lights out.</h1>
    <p class="mt-5 max-w-md text-muted">The page you’re looking for doesn’t exist or has moved.</p>
    <div class="mt-9 flex flex-wrap gap-4">
      <a href="/" class="btn btn-primary">Back to home <Icon name="arrow" /></a>
      <a href="/work/" class="btn btn-outline">View work</a>
    </div>
  </section>
</Base>
