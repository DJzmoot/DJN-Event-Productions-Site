# Contact form delivery endpoint (see README → "Contact form").
# Leave unset to fall back to opening the visitor's email client.
# Example (Web3Forms):  PUBLIC_FORM_ENDPOINT=https://api.web3forms.com/submit
PUBLIC_FORM_ENDPOINT=
# Web3Forms access key — designed to be public; it only allows delivery to
# the inbox registered with it.
PUBLIC_FORM_ACCESS_KEY=
